# ==============================================================================
# R-RPA — configuração
# Copie este arquivo para ".env" antes de subir:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS:         cp .env.example .env
# ==============================================================================

# --- Acesso -------------------------------------------------------------------
# Porta em que o sistema abre no seu computador/servidor (8765 evita conflito com
# outros sistemas que costumam usar 8000 e 8080).
RRPA_PORTA=8765

# Endereço público do sistema, SEM barra no final. Os links de cadastro enviados
# por WhatsApp usam este endereço; com "localhost" eles NÃO abrem no celular do
# candidato. É também o endereço que a Meta chama no webhook do WhatsApp (precisa
# ser HTTPS e público para entregas, leituras e "SAIR" chegarem).
# Em produção: https://rrpa.suaunidade.org.br
RRPA_BASE_URL=http://localhost:8765

# Hosts aceitos (separe por vírgula). Inclua o IP ou domínio que os colegas usam.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Só é necessário atrás de HTTPS/proxy. Exemplo: https://rrpa.suaunidade.org.br
DJANGO_CSRF_TRUSTED_ORIGINS=

# Ative (1) quando o acesso for por HTTPS atrás de um proxy (Caddy, Nginx, Traefik...).
RRPA_HTTPS=0

# --- Primeiro acesso ----------------------------------------------------------
# Administrador criado na primeira execução. Se a senha ficar em branco, uma
# senha aleatória é gerada e escrita no log do container "web".
RRPA_ADMIN_USUARIO=admin
RRPA_ADMIN_SENHA=
RRPA_ADMIN_EMAIL=
RRPA_NOME_UNIDADE=Minha unidade

# --- Demonstração -------------------------------------------------------------
# 1 = carrega dados fictícios (vagas, candidatos, vínculos) e mostra os acessos
# de teste na tela de login. DESLIGUE (0) antes de usar com dados reais.
RRPA_SEED_DEMO=1
RRPA_DEMO_SENHA=demo1234

# --- WhatsApp -----------------------------------------------------------------
# O envio normal abre o WhatsApp (celular ou Web) com a mensagem pronta e não precisa de nada aqui.
# 1 = liga o disparo automático por API (Configurações > WhatsApp, página Disparos, webhook).
# Exige uma conta da API oficial da Meta (ou use o Simulador para treinar). Veja o README.
RRPA_WHATSAPP_API=0

# --- Banco de dados -----------------------------------------------------------
POSTGRES_DB=rrpa
POSTGRES_USER=rrpa
POSTGRES_PASSWORD=troque-esta-senha

# --- Segurança ----------------------------------------------------------------
# Em branco = o sistema gera e guarda uma chave própria no volume de dados.
# Atenção: o token do WhatsApp salvo em Configurações é criptografado com uma chave derivada
# desta. Se ela mudar, as credenciais do WhatsApp precisam ser digitadas de novo.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0

# --- Mapa e localização por CEP -----------------------------------------------
# Consulta de CEP: BrasilAPI e ViaCEP. Coordenadas: BrasilAPI e OpenStreetMap (Nominatim).
# A política do Nominatim pede um contato no User-Agent. Informe um e-mail da unidade:
RRPA_GEOCODER_EMAIL=
# Mapa base (padrão: OpenStreetMap). Para uso intenso, troque por um provedor próprio.
RRPA_MAPA_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
